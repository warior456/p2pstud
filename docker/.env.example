# .env.example — Optional configuration for p2pstud anchor node.
# For a lightweight, zero-domain VPS (storage-only anchor), you can leave .env empty.
#
# Custom Anchor Arguments:
# Override default command flags (default: --data-dir /var/lib/p2pstud --no-relay)
# ANCHOR_ARGS=--data-dir /var/lib/p2pstud --no-relay

# (Optional) If you have a custom domain and want to run a private TLS relay on port 443:
# RELAY_DOMAIN=relay.yourcampus.org
# RELAY_PORT=443
# ANCHOR_ARGS=--data-dir /var/lib/p2pstud --relay-port 443 --cert-dir /etc/letsencrypt/live/relay.yourcampus.org

# (Optional) Specific workspace namespace ID. If omitted, anchors the default shared campus swarm.
# WORKSPACE_ID=

# Egress rate limiting (bytes/sec)
# 153600 = 150 KB/s per peer session
# 2097152 = 2 MB/s aggregate across all sessions
MAX_SESSION_BPS=153600
MAX_AGGREGATE_BPS=2097152

