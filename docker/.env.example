# Copy this file to .env before running: cp .env.example .env
# Then fill in the values below.

# Your relay server's fully-qualified domain name.
# Must match the Let's Encrypt certificate domain.
RELAY_DOMAIN=relay.yourcampus.org

# Port for the relay server (TLS). Usually 443.
RELAY_PORT=443

# Workspace namespace ID. Get this from the workspace admin / invite link.
# Required — the anchor won't start without it.
WORKSPACE_ID=

# Egress rate limiting (bytes/sec).
# 153600 = 150 KB/s per peer session
# 2097152 = 2 MB/s aggregate across all sessions
MAX_SESSION_BPS=153600
MAX_AGGREGATE_BPS=2097152

