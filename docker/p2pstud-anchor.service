[Unit]
Description=P2P Campus Workspace Anchor Node
Documentation=https://github.com/yourorg/p2pstud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=p2pstud
Group=p2pstud
WorkingDirectory=/var/lib/p2pstud

ExecStart=/usr/local/bin/anchor \
    --data-dir /var/lib/p2pstud \
    --relay-port 443 \
    --cert-dir /etc/letsencrypt/live/relay.yourcampus.org \
    --workspace-id YOUR_WORKSPACE_ID_HERE \
    --max-session-bps 153600 \
    --max-aggregate-bps 2097152

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Harden the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/p2pstud
ReadOnlyPaths=/etc/letsencrypt

# Allow binding privileged ports (needed for port 443).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

