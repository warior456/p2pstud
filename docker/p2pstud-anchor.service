[Unit]
Description=P2P Campus Workspace Anchor Node
Documentation=https://github.com/warior456/p2pstud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=p2pstud
Group=p2pstud
WorkingDirectory=/var/lib/p2pstud

# Default to lightweight zero-domain storage anchor (no relay / certs needed).
# To run an embedded TLS relay if you own a domain, add: --relay-port 443 --cert-dir /etc/letsencrypt/live/<domain>
ExecStart=/usr/local/bin/anchor --data-dir /var/lib/p2pstud --no-relay

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Harden the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/p2pstud

# Allow binding privileged ports (if running custom relay on 443).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

